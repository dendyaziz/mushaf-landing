---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="404: Halaman Tidak Ditemukan - Mushaf"
  description="Maaf, halaman yang Anda tuju tidak ditemukan atau telah dipindahkan."
  noindex={true}
>
  <Navbar />

  <main class="flex min-h-[60vh] items-center justify-center px-4 py-16 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-md text-center">
      <div class="inline-flex items-center gap-2 rounded-full border border-emerald-600/20 bg-emerald-50 px-4 py-1 text-xs font-semibold uppercase tracking-wider text-emerald-800">
        Kode Kesalahan 404
      </div>

      <h1 class="mt-6 text-4xl font-extrabold tracking-tight text-slate-900 sm:text-5xl">
        Halaman Tidak Ditemukan
      </h1>

      <p class="mt-4 text-base leading-relaxed text-slate-600">
        Tautan yang Anda tuju mungkin sudah kedaluwarsa, berpindah alamat, atau belum tersedia.
      </p>

      <div class="mt-8">
        <a
          href="/"
          class="inline-flex items-center justify-center rounded-full bg-slate-900 px-6 py-3 text-sm font-semibold text-white shadow-sm transition-all hover:bg-slate-800 active:scale-95"
        >
          &larr; Kembali ke Beranda
        </a>
      </div>
    </div>
  </main>

  <Footer />
</Layout>
