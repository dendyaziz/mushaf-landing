---
---

<header class="sticky top-0 z-50 w-full border-b border-slate-200/80 bg-[#fbfbfa]/90 backdrop-blur-md">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-4 sm:px-6 lg:px-8">
    <!-- Brand Logo & Name -->
    <a href="/" class="group flex items-center gap-3 transition-opacity hover:opacity-95">
      <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-700 p-2 text-white shadow-md shadow-emerald-900/10 transition-transform group-hover:scale-105">
        <img src="/images/logo.svg" alt="Mushaf Logo" class="h-full w-full object-contain invert" />
      </div>
      <div class="flex flex-col">
        <span class="text-xl font-extrabold tracking-tight text-slate-900">
          Mushaf
        </span>
        <span class="-mt-1 text-[11px] font-semibold tracking-wide text-emerald-700">
          Quran Indonesia
        </span>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden items-center gap-8 md:flex">
      <a href="#fitur" class="text-sm font-semibold text-slate-600 transition-colors hover:text-emerald-700">
        Fitur Unggulan
      </a>
      <a href="#kemenag" class="text-sm font-semibold text-slate-600 transition-colors hover:text-emerald-700">
        Standar Kemenag RI
      </a>
      <a href="#unduh" class="text-sm font-semibold text-slate-600 transition-colors hover:text-emerald-700">
        Unduh Aplikasi
      </a>
    </nav>

    <!-- Action Button -->
    <div class="flex items-center gap-3">
      <a
        href="#unduh"
        class="inline-flex items-center justify-center gap-2 rounded-xl bg-emerald-700 px-5 py-2.5 text-sm font-bold text-white shadow-sm shadow-emerald-800/20 transition-all hover:bg-emerald-800 hover:shadow-md active:scale-95"
      >
        <span>Unduh Gratis</span>
        <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M10 3a.75.75 0 01.75.75v10.638l3.96-4.158a.75.75 0 111.08 1.04l-5.25 5.5a.75.75 0 01-1.08 0l-5.25-5.5a.75.75 0 111.08-1.04l3.96 4.158V3.75A.75.75 0 0110 3z" clip-rule="evenodd" />
        </svg>
      </a>
    </div>
  </div>
</header>
