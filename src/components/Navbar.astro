---
---

<header class="sticky top-0 z-50 w-full border-b border-slate-200/60 bg-[#fbfbfa]/80 backdrop-blur-md">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-4 sm:px-6 lg:px-8">
    <!-- Brand Logo & Name -->
    <a href="/" class="group flex items-center gap-3 transition-opacity hover:opacity-90">
      <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-emerald-800 p-2 text-white shadow-sm transition-transform group-hover:scale-105">
        <img src="/images/logo.svg" alt="Mushaf Logo" class="h-full w-full object-contain invert" />
      </div>
      <div class="flex flex-col">
        <span class="text-lg font-bold tracking-tight text-slate-900">
          Mushaf
        </span>
        <span class="-mt-1 text-[11px] font-medium text-slate-500">
          Quran Indonesia
        </span>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden items-center gap-8 text-sm font-medium text-slate-600 md:flex">
      <a href="#fitur" class="transition-colors hover:text-slate-900">
        Fitur
      </a>
      <a href="#kemenag" class="transition-colors hover:text-slate-900">
        Standar Kemenag
      </a>
      <a href="#unduh" class="transition-colors hover:text-slate-900">
        Unduh
      </a>
    </nav>

    <!-- Action Button -->
    <div class="flex items-center gap-3">
      <a
        href="#unduh"
        class="inline-flex items-center justify-center rounded-full bg-slate-900 px-5 py-2 text-xs font-semibold text-white shadow-sm transition-all hover:bg-slate-800 active:scale-95"
      >
        Unduh Aplikasi
      </a>
    </div>
  </div>
</header>
