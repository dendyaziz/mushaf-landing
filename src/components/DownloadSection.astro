---
---

<section id="unduh" class="relative scroll-mt-20 pt-4 pb-16 sm:pt-8 sm:pb-24 lg:pt-10 lg:pb-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="relative overflow-hidden rounded-[36px] sm:rounded-[48px] bg-slate-950 px-8 py-14 text-center text-white shadow-2xl sm:px-16 sm:py-20">
      <!-- Subtle ambient emerald glow -->
      <div class="pointer-events-none absolute -top-32 -right-32 h-[500px] w-[500px] rounded-full bg-emerald-600/20 blur-3xl"></div>
      <div class="pointer-events-none absolute -bottom-32 -left-32 h-[500px] w-[500px] rounded-full bg-teal-600/15 blur-3xl"></div>

      <div class="relative z-10 mx-auto max-w-3xl">
        <h2 class="text-3xl font-extrabold tracking-tight sm:text-5xl lg:text-6xl">
          Mulai Tilawah Hari Ini.
        </h2>

        <p class="mx-auto mt-4 max-w-xl text-base font-normal leading-relaxed text-slate-300 sm:text-lg">
          Tersedia gratis untuk Android. Segera hadir untuk iOS.
        </p>

        <!-- Official Store Badges Container -->
        <div class="mt-10 flex flex-wrap items-center justify-center gap-4 sm:gap-6">
          <!-- Google Play Badge -->
          <a
            href="https://play.google.com/store/apps"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex transition-transform hover:scale-105 active:scale-95"
            aria-label="Unduh di Google Play"
          >
            <img
              src="/images/google-play-badge.svg"
              alt="Temukan di Google Play"
              class="h-12 w-auto sm:h-14 drop-shadow-xl"
            />
          </a>

          <!-- App Store Badge with "Segera Hadir" -->
          <div class="relative inline-flex items-center">
            <div class="opacity-75 grayscale contrast-125 filter">
              <img
                src="/images/app-store-badge.svg"
                alt="Download on the App Store"
                class="h-12 w-auto sm:h-14 drop-shadow-md"
              />
            </div>
            <span class="absolute -top-2 -right-2 rounded-full border border-amber-300 bg-amber-500 px-2.5 py-0.5 text-[9px] font-bold tracking-wider uppercase text-white shadow-md">
              Segera Hadir
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
