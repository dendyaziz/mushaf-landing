---
---

<section id="unduh" class="relative scroll-mt-20 py-20 lg:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="relative overflow-hidden rounded-[40px] bg-gradient-to-br from-emerald-900 via-emerald-950 to-slate-950 px-8 py-16 text-center text-white shadow-2xl shadow-emerald-950/20 sm:px-16 sm:py-24">
      <!-- Subtle ambient glowing orbs -->
      <div class="pointer-events-none absolute -top-32 -right-32 h-[450px] w-[450px] rounded-full bg-emerald-500/20 blur-3xl"></div>
      <div class="pointer-events-none absolute -bottom-32 -left-32 h-[450px] w-[450px] rounded-full bg-teal-500/20 blur-3xl"></div>

      <div class="relative z-10 mx-auto max-w-3xl">
        <span class="inline-flex items-center gap-1.5 rounded-full border border-emerald-400/30 bg-emerald-500/20 px-4 py-1.5 text-xs font-bold tracking-wide uppercase text-emerald-300">
          Unduh Gratis
        </span>

        <h2 class="mt-6 text-3xl font-extrabold tracking-tight sm:text-4xl lg:text-5xl">
          Mulai Tilawah Tanpa Hambatan Sekarang Juga
        </h2>

        <p class="mx-auto mt-5 max-w-2xl text-base leading-relaxed text-emerald-100/90 sm:text-lg">
          Aplikasi ringan (~15 MB), cepat dibuka, dan 100% offline. Manfaatkan sela-sela waktu harian Anda untuk membaca Al-Qur'an dengan tenang dan lancar.
        </p>

        <!-- Official Store Badges Container -->
        <div class="mt-10 flex flex-wrap items-center justify-center gap-5 sm:gap-6">
          <!-- Google Play Badge -->
          <a
            href="https://play.google.com/store/apps"
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex transition-transform hover:scale-105 active:scale-98"
            aria-label="Unduh di Google Play"
          >
            <img
              src="/images/google-play-badge.svg"
              alt="Temukan di Google Play"
              class="h-14 w-auto drop-shadow-xl transition-all group-hover:drop-shadow-2xl"
            />
          </a>

          <!-- App Store Badge with "Segera Hadir" -->
          <div class="relative inline-flex items-center">
            <div class="opacity-75 grayscale contrast-125 filter">
              <img
                src="/images/app-store-badge.svg"
                alt="Download on the App Store"
                class="h-14 w-auto drop-shadow-md"
              />
            </div>
            <span class="absolute -top-3 -right-3 rounded-full border border-amber-300 bg-amber-500 px-3 py-0.5 text-[10px] font-extrabold tracking-wider uppercase text-white shadow-md">
              Segera Hadir
            </span>
          </div>
        </div>

        <!-- Footnote details -->
        <div class="mt-10 flex flex-wrap items-center justify-center gap-6 text-xs text-emerald-200/70 sm:gap-8">
          <span>✓ Gratis Selamanya</span>
          <span>✓ Tanpa Perlu Daftar Akun</span>
          <span>✓ Tanpa Kuota Internet</span>
          <span>✓ Kompatibel Android 8.0+</span>
        </div>
      </div>
    </div>
  </div>
</section>
