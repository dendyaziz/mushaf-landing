---
---

<section class="relative overflow-hidden pt-8 pb-16 lg:pt-16 lg:pb-24">
  <!-- Subtle ambient background glow -->
  <div class="pointer-events-none absolute -top-40 left-1/2 -z-10 h-[500px] w-[700px] -translate-x-1/2 rounded-full bg-gradient-to-tr from-emerald-200/40 via-teal-100/30 to-amber-100/20 blur-3xl dark:from-emerald-950/40 dark:via-teal-950/20 dark:to-slate-900/10"></div>

  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="grid items-center gap-12 lg:grid-cols-12 lg:gap-8">
      <!-- Left Column: Copywriting & Actions -->
      <div class="flex flex-col items-start text-left lg:col-span-7">
        <!-- Pill Badge -->
        <div class="inline-flex items-center gap-2 rounded-full border border-emerald-600/20 bg-emerald-50/80 px-3.5 py-1.5 text-xs font-semibold text-emerald-800 backdrop-blur-xs dark:border-emerald-500/30 dark:bg-emerald-950/60 dark:text-emerald-300">
          <span class="flex h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>Mushaf Standar Kemenag RI • 100% Akses Offline</span>
        </div>

        <!-- Main Headline -->
        <h1 class="mt-5 text-4xl font-extrabold tracking-tight text-slate-900 sm:text-5xl sm:leading-[1.15] lg:text-[52px] dark:text-white">
          Membaca Al-Qur'an <br class="hidden sm:inline" />
          Lebih Tenang, <span class="bg-gradient-to-r from-emerald-600 to-teal-600 bg-clip-text text-transparent dark:from-emerald-400 dark:to-teal-300">Mengalir Tanpa Beban.</span>
        </h1>

        <!-- Natural Indonesian Subtitle -->
        <p class="mt-5 text-base leading-relaxed text-slate-600 sm:text-lg dark:text-slate-300">
          Buka aplikasi dan langsung lanjutkan tilawah tepat di ayat terakhir Anda. Nikmati kenyamanan teks rasm Usmani standar Kementerian Agama RI, panduan tajwid berwarna yang jelas, serta kemudahan membaca sepenuhnya tanpa koneksi internet.
        </p>

        <!-- CTA Action Buttons -->
        <div class="mt-8 flex w-full flex-col gap-3.5 sm:flex-row sm:items-center">
          <!-- Android Play Store Button -->
          <a
            href="https://play.google.com/store/apps"
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex items-center justify-center gap-3 rounded-2xl bg-slate-900 px-6 py-3.5 text-white shadow-md shadow-slate-950/20 transition-all hover:bg-slate-800 hover:shadow-lg hover:shadow-slate-900/30 active:scale-[0.98] dark:bg-emerald-600 dark:hover:bg-emerald-500"
          >
            <!-- Google Play Icon -->
            <svg class="h-6 w-6 shrink-0 transition-transform group-hover:scale-110" viewBox="0 0 24 24" fill="currentColor">
              <path d="M3.609 1.814L13.792 12 3.61 22.186a1.94 1.94 0 0 1-.61-.954V2.768c.09-.377.305-.722.609-.954zm11.242 11.245l2.259 2.259-11.835 6.763 9.576-9.022zm0-2.118L5.275 1.919l11.835 6.763-2.259 2.259zm1.096 1.059l4.57 2.612c1.077.615 1.077 1.621 0 2.236l-4.57 2.611-2.527-2.527 2.527-2.932z" />
            </svg>
            <div class="flex flex-col text-left">
              <span class="text-[11px] uppercase tracking-wider text-slate-300 dark:text-emerald-100">Tersedia di</span>
              <span class="text-base font-bold leading-tight">Google Play</span>
            </div>
          </a>

          <!-- iOS Coming Soon Badge -->
          <div class="inline-flex items-center justify-center gap-3 rounded-2xl border border-slate-200 bg-white/70 px-5 py-3 text-slate-700 backdrop-blur-xs dark:border-slate-800 dark:bg-slate-900/60 dark:text-slate-300">
            <!-- Apple Icon -->
            <svg class="h-6 w-6 shrink-0 text-slate-500 dark:text-slate-400" viewBox="0 0 24 24" fill="currentColor">
              <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.38c.62-.75 1.04-1.8 0.93-2.85-.9.04-1.99.6-2.61 1.35-.55.63-.99 1.68-.86 2.7 1 .08 2.02-.51 2.54-1.2" />
            </svg>
            <div class="flex flex-col text-left">
              <span class="text-[11px] font-medium text-slate-400 dark:text-slate-500">App Store (iOS)</span>
              <span class="text-xs font-semibold text-emerald-700 dark:text-emerald-400">Segera Hadir</span>
            </div>
          </div>
        </div>

        <!-- Feature Micro-bullets -->
        <div class="mt-8 grid grid-cols-1 gap-2.5 text-xs font-medium text-slate-600 sm:grid-cols-3 sm:gap-4 dark:text-slate-400">
          <div class="flex items-center gap-2">
            <svg class="h-4 w-4 shrink-0 text-emerald-600 dark:text-emerald-400" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" />
            </svg>
            <span>Lanjut baca otomatis</span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="h-4 w-4 shrink-0 text-emerald-600 dark:text-emerald-400" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" />
            </svg>
            <span>Rasm Usmani Kemenag</span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="h-4 w-4 shrink-0 text-emerald-600 dark:text-emerald-400" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" />
            </svg>
            <span>100% Bebas Kuota</span>
          </div>
        </div>
      </div>

      <!-- Right Column: Interactive-like Smartphone Mockup -->
      <div class="flex justify-center lg:col-span-5">
        <div class="relative w-full max-w-[320px] sm:max-w-[340px]">
          <!-- Glow Accent Behind Device -->
          <div class="absolute -inset-4 rounded-[40px] bg-gradient-to-b from-emerald-500/20 to-teal-500/5 blur-xl"></div>

          <!-- Smartphone Shell -->
          <div class="relative rounded-[36px] border-4 border-slate-800 bg-slate-900 p-3 shadow-2xl shadow-emerald-950/20 dark:border-slate-700">
            <!-- Camera Speaker Island -->
            <div class="absolute top-4 left-1/2 h-3.5 w-20 -translate-x-1/2 rounded-full bg-slate-950"></div>

            <!-- Screen Area -->
            <div class="relative flex min-h-[560px] flex-col justify-between overflow-hidden rounded-[26px] bg-[#fbfbf8] text-slate-900 dark:bg-[#0c1a14] dark:text-slate-100">
              <!-- Top App Status Bar & Surah Header -->
              <div class="border-b border-emerald-900/5 bg-emerald-50/70 p-4 pt-6 dark:border-emerald-500/10 dark:bg-emerald-950/40">
                <div class="flex items-center justify-between text-xs">
                  <span class="font-semibold text-emerald-800 dark:text-emerald-300">Surah Al-Kahf (18)</span>
                  <span class="rounded-md bg-emerald-200/60 px-2 py-0.5 text-[10px] font-bold text-emerald-900 dark:bg-emerald-900 dark:text-emerald-200">Juz 15</span>
                </div>

                <!-- Last Read Indicator Banner -->
                <div class="mt-3 flex items-center justify-between rounded-xl bg-emerald-600 px-3 py-1.5 text-xs text-white shadow-xs">
                  <div class="flex items-center gap-1.5 font-medium">
                    <svg class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm.75-13a.75.75 0 00-1.5 0v5c0 .414.336.75.75.75h4a.75.75 0 000-1.5h-3.25V5z" clip-rule="evenodd" />
                    </svg>
                    <span>Lanjut dari Ayat 28</span>
                  </div>
                  <span class="text-[10px] opacity-80">Otomatis</span>
                </div>
              </div>

              <!-- Reading View Content -->
              <div class="flex-1 space-y-4 p-4 text-center">
                <!-- Ayat 28 Example -->
                <div class="rounded-2xl border border-emerald-600/20 bg-white p-3.5 shadow-xs dark:border-emerald-500/20 dark:bg-[#12231c]">
                  <!-- Arabic Text -->
                  <p class="font-['Amiri_Quran',serif] text-xl leading-[2.2] text-slate-900 dir-rtl text-right dark:text-emerald-50">
                    وَٱصْبِرْ نَفْسَكَ مَعَ ٱلَّذِينَ يَدْعُونَ رَبَّهُم بِٱلْغَدَوٰةِ وَٱلْعَشِىِّ يُرِيدُونَ وَجْهَهُۥ ۖ
                    <span class="inline-flex h-6 w-6 items-center justify-center rounded-full border border-emerald-600 text-xs text-emerald-700 dark:border-emerald-400 dark:text-emerald-300">۲۸</span>
                  </p>
                  <!-- Translation -->
                  <p class="mt-3 text-left text-xs leading-relaxed text-slate-600 dark:text-slate-300">
                    "Dan bersabarlah engkau bersama orang yang menyeru Tuhannya pada pagi dan petang hari dengan mengharap keridaan-Nya..."
                  </p>
                </div>

                <!-- Ayat 29 Example -->
                <div class="rounded-2xl border border-slate-100 bg-white/70 p-3.5 opacity-80 dark:border-emerald-950 dark:bg-[#12231c]/60">
                  <p class="font-['Amiri_Quran',serif] text-lg leading-[2] text-slate-800 text-right dark:text-slate-200">
                    وَقُلِ ٱلْحَقُّ مِن رَّبِّكُمْ ۖ فَمَن شَآءَ فَلْيُؤْمِن وَمَن شَآءَ فَلْيَكْفُرْ ۚ
                    <span class="inline-flex h-5 w-5 items-center justify-center rounded-full border border-slate-400 text-[10px] text-slate-500">۲۹</span>
                  </p>
                  <p class="mt-2 text-left text-[11px] leading-relaxed text-slate-500 dark:text-slate-400">
                    "Dan katakanlah (Muhammad), 'Kebenaran itu datangnya dari Tuhanmu; barangsiapa menghendaki berimanlah...'"
                  </p>
                </div>
              </div>

              <!-- Mobile App Bottom Navigation Bar -->
              <div class="flex items-center justify-around border-t border-slate-200/80 bg-white px-4 py-2.5 text-slate-400 dark:border-slate-800 dark:bg-[#091510]">
                <div class="flex flex-col items-center gap-0.5 text-emerald-600 dark:text-emerald-400">
                  <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 3L2 12h3v8h6v-6h2v6h6v-8h3L12 3z"/>
                  </svg>
                  <span class="text-[9px] font-semibold">Surah</span>
                </div>
                <div class="flex flex-col items-center gap-0.5">
                  <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"/>
                  </svg>
                  <span class="text-[9px]">Juz</span>
                </div>
                <div class="flex flex-col items-center gap-0.5">
                  <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"/>
                  </svg>
                  <span class="text-[9px]">Tandai</span>
                </div>
                <div class="flex flex-col items-center gap-0.5">
                  <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="3"/>
                    <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/>
                  </svg>
                  <span class="text-[9px]">Setelan</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
