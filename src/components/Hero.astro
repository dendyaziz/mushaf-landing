---
---

<section class="relative overflow-hidden pt-10 pb-20 lg:pt-16 lg:pb-28">
  <!-- Subtle ambient glow in warm emerald & amber -->
  <div class="pointer-events-none absolute top-0 left-1/2 -z-10 h-[650px] w-[1000px] -translate-x-1/2 rounded-full bg-gradient-to-tr from-emerald-100/60 via-teal-50/40 to-amber-100/30 blur-3xl"></div>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid items-center gap-12 lg:grid-cols-12 lg:gap-16">
      <!-- Left Column: Copywriting & Store Badges -->
      <div class="flex flex-col items-start text-left lg:col-span-7">
        <!-- Feature Highlights Pill -->
        <div class="inline-flex items-center gap-2 rounded-full border border-emerald-700/15 bg-white px-4 py-1.5 text-xs font-bold text-emerald-800 shadow-xs">
          <span class="flex h-2 w-2 rounded-full bg-emerald-600 animate-pulse"></span>
          <span>100% Offline • Tanpa Iklan • Langsung Ayat Terakhir</span>
        </div>

        <!-- Main Headline -->
        <h1 class="mt-6 text-4xl font-extrabold tracking-tight text-slate-900 sm:text-5xl lg:text-6xl sm:leading-[1.12]">
          Baca Al-Qur'an Kapan Saja, Di Mana Saja.
          <span class="mt-2 block bg-gradient-to-r from-emerald-700 via-emerald-800 to-teal-800 bg-clip-text text-transparent">
            Buka Aplikasi, Langsung Ayat Terakhir Anda.
          </span>
        </h1>

        <!-- Direct & Natural Subtitle -->
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-slate-600 sm:text-xl">
          Tidak perlu lagi mencari nomor halaman atau repot mengingat bookmark manual. Mushaf dirancang tanpa jeda loading, tanpa iklan mengganggu, dan 100% offline dengan rasm Usmani standar Kemenag RI. Manfaatkan setiap sela waktu Anda untuk membaca Al-Qur'an dengan tenang.
        </p>

        <!-- Official Store Badges -->
        <div class="mt-9 flex flex-wrap items-center gap-4 sm:gap-5">
          <!-- Official Google Play Badge -->
          <a
            href="https://play.google.com/store/apps"
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex transition-transform hover:scale-105 active:scale-98"
            aria-label="Unduh di Google Play"
          >
            <img
              src="/images/google-play-badge.svg"
              alt="Temukan di Google Play"
              class="h-[52px] w-auto drop-shadow-md transition-all group-hover:drop-shadow-lg"
            />
          </a>

          <!-- Official App Store Badge with "Segera Hadir" -->
          <div class="relative inline-flex items-center">
            <div class="opacity-75 grayscale contrast-125 filter">
              <img
                src="/images/app-store-badge.svg"
                alt="Download on the App Store"
                class="h-[52px] w-auto drop-shadow-sm"
              />
            </div>
            <!-- Overlay Badge -->
            <span class="absolute -top-2.5 -right-2.5 rounded-full border border-amber-300 bg-amber-500 px-2.5 py-0.5 text-[10px] font-extrabold tracking-wider uppercase text-white shadow-sm">
              Segera Hadir
            </span>
          </div>
        </div>

        <!-- Trust Badges -->
        <div class="mt-10 flex flex-wrap items-center gap-6 border-t border-slate-200/80 pt-6 text-xs font-semibold text-slate-600 sm:gap-8">
          <div class="flex items-center gap-2">
            <div class="flex h-5 w-5 items-center justify-center rounded-full bg-emerald-100 text-emerald-800">
              ✓
            </div>
            <span>0 Detik Loading (Instan)</span>
          </div>
          <div class="flex items-center gap-2">
            <div class="flex h-5 w-5 items-center justify-center rounded-full bg-emerald-100 text-emerald-800">
              ✓
            </div>
            <span>Mushaf Standar Kemenag RI</span>
          </div>
          <div class="flex items-center gap-2">
            <div class="flex h-5 w-5 items-center justify-center rounded-full bg-emerald-100 text-emerald-800">
              ✓
            </div>
            <span>100% Bebas Kuota Data</span>
          </div>
        </div>
      </div>

      <!-- Right Column: Dynamic 3D Smartphone Showcase -->
      <div class="relative flex justify-center lg:col-span-5 lg:justify-end">
        <!-- Ambient Drop Blur behind image -->
        <div class="absolute -inset-4 rounded-3xl bg-gradient-to-tr from-emerald-600/15 via-teal-500/10 to-transparent blur-2xl"></div>

        <!-- Phone Card Wrapper -->
        <div class="relative w-full max-w-[400px] overflow-hidden rounded-[32px] border border-slate-200/80 bg-white p-2.5 shadow-[0_30px_70px_-15px_rgba(6,78,59,0.18)] transition-transform hover:scale-[1.01]">
          <!-- High-res AI-generated 3D dynamic perspective mockup -->
          <img
            src="/images/mushaf-hero-mockup.jpg"
            alt="Preview Tampilan Aplikasi Mushaf Al-Quran Indonesia"
            class="h-auto w-full rounded-[24px] object-cover"
            loading="eager"
          />

          <!-- Floating Interactive-like Status Pill 1 -->
          <div class="absolute top-8 left-6 rounded-2xl border border-emerald-700/20 bg-white/95 px-3.5 py-2 text-xs font-bold text-emerald-900 shadow-lg backdrop-blur-md">
            <div class="flex items-center gap-2">
              <span class="flex h-2 w-2 rounded-full bg-emerald-600"></span>
              <span>Lanjut Baca Otomatis: Surah Al-Kahf</span>
            </div>
          </div>

          <!-- Floating Interactive-like Status Pill 2 -->
          <div class="absolute right-6 bottom-8 rounded-2xl border border-slate-200/80 bg-white/95 px-4 py-2.5 text-xs font-semibold text-slate-800 shadow-xl backdrop-blur-md">
            <div class="flex items-center gap-2">
              <span class="text-base">⚡</span>
              <div>
                <div class="text-[10px] text-slate-400 font-normal uppercase tracking-wider">Akses Penuh</div>
                <div class="font-bold text-slate-900">100% Siap Tanpa Internet</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
