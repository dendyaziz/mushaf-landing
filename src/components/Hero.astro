---
---

<section class="relative overflow-hidden pt-12 pb-24 sm:pt-20 sm:pb-32 lg:pt-24 lg:pb-36">
  <!-- Soft ambient radial background -->
  <div class="pointer-events-none absolute top-0 left-1/2 -z-10 h-[700px] w-[1100px] -translate-x-1/2 rounded-full bg-gradient-to-b from-emerald-100/40 via-teal-50/20 to-transparent blur-3xl"></div>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto flex max-w-4xl flex-col items-center text-center">
      <!-- Apple-style Clean, Punchy Headline -->
      <h1 class="text-4xl font-extrabold tracking-tight text-slate-900 sm:text-6xl lg:text-7xl sm:leading-[1.1]">
        Buka Aplikasi. Langsung Ayat Terakhir.
      </h1>

      <!-- Short, Confident Subtitle (No Long Paragraphs) -->
      <p class="mt-6 max-w-2xl text-lg font-normal leading-relaxed text-slate-600 sm:text-xl">
        Baca Al-Qur'an kapan saja dan di mana saja. Tanpa jeda loading, tanpa iklan, dan 100% offline berstandar Kemenag RI.
      </p>

      <!-- Store Download Badges (Centered, Minimalist) -->
      <div class="mt-10 flex flex-wrap items-center justify-center gap-4 sm:gap-6">
        <a
          href="https://play.google.com/store/apps"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex transition-transform hover:scale-105 active:scale-95"
          aria-label="Unduh di Google Play"
        >
          <img
            src="/images/google-play-badge.svg"
            alt="Temukan di Google Play"
            class="h-12 w-auto sm:h-14 drop-shadow-sm transition-all hover:drop-shadow-md"
          />
        </a>

        <div class="relative inline-flex items-center">
          <div class="opacity-75 grayscale contrast-125 filter">
            <img
              src="/images/app-store-badge.svg"
              alt="Download on the App Store"
              class="h-12 w-auto sm:h-14 drop-shadow-sm"
            />
          </div>
          <span class="absolute -top-2 -right-2 rounded-full border border-amber-300 bg-amber-500 px-2.5 py-0.5 text-[9px] font-bold tracking-wider uppercase text-white shadow-sm">
            Segera Hadir
          </span>
        </div>
      </div>
    </div>

    <!-- Centerpiece Immersive 3D Phone Showcase -->
    <div class="relative mt-14 sm:mt-20 lg:mt-24 flex items-center justify-center">
      <!-- Soft ambient light behind phone -->
      <div class="pointer-events-none absolute -inset-8 rounded-full bg-gradient-to-tr from-emerald-500/10 via-teal-400/10 to-amber-200/10 blur-3xl"></div>

      <img
        src="/images/mushaf-phone-transparent.png"
        alt="Tampilan Aplikasi Mushaf Al-Quran Indonesia di Smartphone"
        class="relative z-10 h-auto w-full max-w-[320px] sm:max-w-[420px] lg:max-w-[480px] drop-shadow-[0_30px_60px_rgba(6,78,59,0.18)] transition-transform duration-700 hover:scale-[1.02]"
        loading="eager"
      />
    </div>
  </div>
</section>
