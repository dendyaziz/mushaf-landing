---
---

<section id="fitur" class="relative scroll-mt-20 py-16 sm:py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="mx-auto max-w-2xl text-center">
      <div class="inline-flex items-center gap-1.5 rounded-full bg-emerald-100/80 px-3 py-1 text-xs font-semibold text-emerald-800 dark:bg-emerald-950/80 dark:text-emerald-300">
        Dirancang Khusus untuk Tilawah Tenang
      </div>
      <h2 class="mt-4 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl dark:text-white">
        Fokus Membaca, Tanpa Gangguan
      </h2>
      <p class="mt-3 text-base leading-relaxed text-slate-600 dark:text-slate-300">
        Mushaf menghilangkan kerumitan navigasi agar Anda dapat langsung terhubung dengan ayat-ayat suci Al-Qur'an kapan pun dan di mana pun.
      </p>
    </div>

    <!-- 3 Core Features Grid -->
    <div class="mt-14 grid gap-8 md:grid-cols-3">
      <!-- Feature 1: Read from where you left -->
      <div class="group relative flex flex-col justify-between rounded-3xl border border-emerald-600/15 bg-white p-7 shadow-sm shadow-emerald-950/5 transition-all duration-300 hover:-translate-y-1 hover:border-emerald-600/30 hover:shadow-xl hover:shadow-emerald-950/10 dark:border-emerald-500/15 dark:bg-[#0f1f18]">
        <div>
          <!-- Icon -->
          <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-emerald-500/10 text-emerald-600 transition-colors group-hover:bg-emerald-600 group-hover:text-white dark:bg-emerald-400/10 dark:text-emerald-400">
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10" />
              <polyline points="12 6 12 12 16 14" />
            </svg>
          </div>

          <span class="mt-5 inline-block text-[11px] font-bold uppercase tracking-wider text-emerald-700 dark:text-emerald-400">
            Lanjut Otomatis
          </span>
          <h3 class="mt-1 text-xl font-bold text-slate-900 dark:text-white">
            Buka Kembali Tepat di Ayat Terakhir
          </h3>
          <p class="mt-3 text-sm leading-relaxed text-slate-600 dark:text-slate-300">
            Tidak perlu lagi mengingat nomor halaman atau repot memasang bookmark manual. Setiap kali aplikasi dibuka, Mushaf langsung mengantarkan Anda ke ayat yang sedang Anda baca. Menandai bacaan kini menjadi pilihan, bukan keharusan.
          </p>
        </div>

        <!-- Mini Visual Widget -->
        <div class="mt-6 rounded-2xl border border-emerald-900/5 bg-emerald-50/50 p-3.5 text-xs text-slate-700 dark:border-emerald-500/10 dark:bg-emerald-950/30 dark:text-slate-300">
          <div class="flex items-center justify-between">
            <span class="font-medium text-emerald-800 dark:text-emerald-300">Riwayat Terakhir</span>
            <span class="text-[10px] text-slate-400">Tersimpan</span>
          </div>
          <div class="mt-1.5 font-semibold text-slate-800 dark:text-slate-200">
            Surah Al-Kahf: Ayat 28
          </div>
        </div>
      </div>

      <!-- Feature 2: Official Kemenag Mushaf with Tajwid -->
      <div id="keunggulan" class="group relative flex flex-col justify-between rounded-3xl border border-emerald-600/15 bg-white p-7 shadow-sm shadow-emerald-950/5 transition-all duration-300 hover:-translate-y-1 hover:border-emerald-600/30 hover:shadow-xl hover:shadow-emerald-950/10 dark:border-emerald-500/15 dark:bg-[#0f1f18]">
        <div>
          <!-- Icon -->
          <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-teal-500/10 text-teal-600 transition-colors group-hover:bg-teal-600 group-hover:text-white dark:bg-teal-400/10 dark:text-teal-400">
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z" />
              <path d="M6 6h10" />
              <path d="M6 10h10" />
            </svg>
          </div>

          <span class="mt-5 inline-block text-[11px] font-bold uppercase tracking-wider text-teal-700 dark:text-teal-400">
            Standar Sahih & Resmi
          </span>
          <h3 class="mt-1 text-xl font-bold text-slate-900 dark:text-white">
            Rasm Usmani Standar Kemenag RI
          </h3>
          <p class="mt-3 text-sm leading-relaxed text-slate-600 dark:text-slate-300">
            Mengadopsi teks mushaf resmi Kementerian Agama RI dengan rasm Usmani yang presisi. Dilengkapi kaidah tajwid berwarna yang jernih serta terjemahan bahasa Indonesia resmi yang mudah dipahami seluruh kalangan.
          </p>
        </div>

        <!-- Mini Visual Widget -->
        <div class="mt-6 flex items-center justify-around rounded-2xl border border-teal-900/5 bg-teal-50/50 p-3 text-xs dark:border-teal-500/10 dark:bg-teal-950/30">
          <span class="inline-flex items-center gap-1 font-medium text-emerald-700 dark:text-emerald-300">
            <span class="h-2 w-2 rounded-full bg-emerald-500"></span> Ikhfa
          </span>
          <span class="inline-flex items-center gap-1 font-medium text-blue-700 dark:text-blue-300">
            <span class="h-2 w-2 rounded-full bg-blue-500"></span> Qalqalah
          </span>
          <span class="inline-flex items-center gap-1 font-medium text-amber-700 dark:text-amber-300">
            <span class="h-2 w-2 rounded-full bg-amber-500"></span> Ghunnah
          </span>
        </div>
      </div>

      <!-- Feature 3: Full offline support -->
      <div class="group relative flex flex-col justify-between rounded-3xl border border-emerald-600/15 bg-white p-7 shadow-sm shadow-emerald-950/5 transition-all duration-300 hover:-translate-y-1 hover:border-emerald-600/30 hover:shadow-xl hover:shadow-emerald-950/10 dark:border-emerald-500/15 dark:bg-[#0f1f18]">
        <div>
          <!-- Icon -->
          <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-amber-500/10 text-amber-600 transition-colors group-hover:bg-amber-600 group-hover:text-white dark:bg-amber-400/10 dark:text-amber-400">
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="1" y1="1" x2="23" y2="23" />
              <path d="M16.72 11.06A10.94 10.94 0 0 1 19 12.55" />
              <path d="M5 12.55a10.94 10.94 0 0 1 5.17-2.39" />
              <path d="M10.71 5.05A16 16 0 0 1 22.58 9" />
              <path d="M1.42 9a15.91 15.91 0 0 1 4.7-2.88" />
              <path d="M8.53 16.11a6 6 0 0 1 6.95 0" />
              <line x1="12" y1="20" x2="12.01" y2="20" />
            </svg>
          </div>

          <span class="mt-5 inline-block text-[11px] font-bold uppercase tracking-wider text-amber-700 dark:text-amber-400">
            100% Akses Penuh
          </span>
          <h3 class="mt-1 text-xl font-bold text-slate-900 dark:text-white">
            Tilawah Sepenuhnya Tanpa Internet
          </h3>
          <p class="mt-3 text-sm leading-relaxed text-slate-600 dark:text-slate-300">
            Seluruh 30 juz, 114 surah, dan terjemahan langsung siap sejak pertama kali aplikasi dipasang. Membaca Al-Qur'an di perjalanan, di pelosok, atau di masjid saat mode pesawat tetap lancar tanpa memotong kuota.
          </p>
        </div>

        <!-- Mini Visual Widget -->
        <div class="mt-6 flex items-center justify-between rounded-2xl border border-amber-900/5 bg-amber-50/50 p-3.5 text-xs dark:border-amber-500/10 dark:bg-amber-950/30">
          <div class="flex items-center gap-2">
            <span class="flex h-2 w-2 rounded-full bg-emerald-500"></span>
            <span class="font-medium text-slate-800 dark:text-slate-200">Mode Offline Aktif</span>
          </div>
          <span class="font-bold text-emerald-700 dark:text-emerald-400">0 KB Kuota</span>
        </div>
      </div>
    </div>
  </div>
</section>
