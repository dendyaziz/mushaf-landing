---
---

<footer class="border-t border-slate-200/80 bg-white py-14">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-12 lg:gap-12">
      <!-- Col 1: Brand & Bio (Span 6) -->
      <div class="lg:col-span-6">
        <a href="/" class="flex items-center gap-3">
          <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-emerald-700 p-2 text-white">
            <img src="/images/logo.svg" alt="Mushaf Logo" class="h-full w-full object-contain invert" />
          </div>
          <div class="flex flex-col">
            <span class="text-xl font-extrabold tracking-tight text-slate-900">
              Mushaf
            </span>
            <span class="-mt-1 text-[11px] font-semibold text-emerald-700">
              Quran Indonesia
            </span>
          </div>
        </a>
        <p class="mt-4 max-w-md text-sm leading-relaxed text-slate-600">
          Aplikasi Al-Qur'an digital standar Kementerian Agama Republik Indonesia yang dirancang untuk menghadirkan kemudahan tilawah di setiap sela waktu luang Anda. Cepat dibuka, tanpa jeda loading, dan 100% offline.
        </p>

        <!-- Official Support Contact -->
        <div class="mt-5 flex items-center gap-2.5 text-sm text-slate-700">
          <svg class="h-4 w-4 text-emerald-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
            <polyline points="22,6 12,13 2,6" />
          </svg>
          <span class="font-medium text-slate-500">Kontak & Bantuan:</span>
          <a
            href="mailto:bantuan@mushaf.web.id"
            class="font-bold text-emerald-800 underline decoration-emerald-600/30 underline-offset-4 transition-colors hover:text-emerald-700"
          >
            bantuan@mushaf.web.id
          </a>
        </div>
      </div>

      <!-- Col 2: Navigation (Span 3) -->
      <div class="lg:col-span-3">
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-900">
          Navigasi
        </h4>
        <ul class="mt-4 space-y-3 text-sm">
          <li>
            <a href="/" class="text-slate-600 transition-colors hover:text-emerald-700">
              Beranda
            </a>
          </li>
          <li>
            <a href="#fitur" class="text-slate-600 transition-colors hover:text-emerald-700">
              Fitur Unggulan
            </a>
          </li>
          <li>
            <a href="#kemenag" class="text-slate-600 transition-colors hover:text-emerald-700">
              Standar Kemenag RI
            </a>
          </li>
          <li>
            <a href="#unduh" class="text-slate-600 transition-colors hover:text-emerald-700">
              Unduh Aplikasi
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 3: Legal & Kebijakan (Span 3) -->
      <div class="lg:col-span-3">
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-900">
          Kebijakan & Legal
        </h4>
        <ul class="mt-4 space-y-3 text-sm">
          <li>
            <a href="/kebijakan-privasi/" class="text-slate-600 transition-colors hover:text-emerald-700">
              Kebijakan Privasi
            </a>
          </li>
          <li>
            <a href="/syarat-ketentuan/" class="text-slate-600 transition-colors hover:text-emerald-700">
              Syarat & Ketentuan
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Copyright -->
    <div class="mt-12 border-t border-slate-200/80 pt-6 text-center text-xs text-slate-500">
      <p>&copy; {new Date().getFullYear()} Mushaf (mushaf.web.id). Seluruh hak cipta dilindungi undang-undang.</p>
    </div>
  </div>
</footer>
