---
---

<footer class="border-t border-slate-200/80 bg-white py-14">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-12 lg:gap-12">
      <!-- Col 1: Brand & Bio (Span 6) -->
      <div class="lg:col-span-6">
        <a href="/" class="flex items-center gap-3">
          <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-emerald-800 p-1.5 text-white">
            <img src="/images/logo.svg" alt="Mushaf Logo" class="h-full w-full object-contain invert" />
          </div>
          <div class="flex flex-col">
            <span class="text-lg font-bold tracking-tight text-slate-900">
              Mushaf
            </span>
            <span class="-mt-1 text-[11px] font-medium text-slate-500">
              Quran Indonesia
            </span>
          </div>
        </a>
        <p class="mt-4 max-w-sm text-sm font-normal leading-relaxed text-slate-500">
          Aplikasi Al-Qur'an digital standar Kemenag RI yang cepat, hening, dan 100% offline.
        </p>

        <!-- Official Support Contact -->
        <div class="mt-6 flex flex-col gap-1 text-sm">
          <span class="text-xs font-semibold uppercase tracking-wider text-slate-400">Hubungi Kami</span>
          <a
            href="mailto:bantuan@mushaf.web.id"
            class="inline-flex items-center gap-1.5 font-medium text-slate-900 transition-colors hover:text-emerald-700"
          >
            <svg class="h-4 w-4 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            bantuan@mushaf.web.id
          </a>
        </div>
      </div>

      <!-- Col 2: Navigation (Span 3) -->
      <div class="lg:col-span-3">
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-900">
          Navigasi
        </h4>
        <ul class="mt-4 space-y-3 text-sm">
          <li>
            <a href="/" class="text-slate-600 transition-colors hover:text-emerald-700">
              Beranda
            </a>
          </li>
          <li>
            <a href="#fitur" class="text-slate-600 transition-colors hover:text-emerald-700">
              Fitur Unggulan
            </a>
          </li>
          <li>
            <a href="#kemenag" class="text-slate-600 transition-colors hover:text-emerald-700">
              Standar Kemenag RI
            </a>
          </li>
          <li>
            <a href="#unduh" class="text-slate-600 transition-colors hover:text-emerald-700">
              Unduh Aplikasi
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 3: Legal & Kebijakan (Span 3) -->
      <div class="lg:col-span-3">
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-900">
          Kebijakan & Legal
        </h4>
        <ul class="mt-4 space-y-3 text-sm">
          <li>
            <a href="/kebijakan-privasi/" class="text-slate-600 transition-colors hover:text-emerald-700">
              Kebijakan Privasi
            </a>
          </li>
          <li>
            <a href="/syarat-ketentuan/" class="text-slate-600 transition-colors hover:text-emerald-700">
              Syarat & Ketentuan
            </a>
          </li>
          <li>
            <a href="/hapus-akun/" class="text-slate-600 transition-colors hover:text-emerald-700">
              Hapus Akun
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Copyright -->
    <div class="mt-12 border-t border-slate-200/80 pt-6 text-center text-xs text-slate-500">
      <p>&copy; {new Date().getFullYear()} Mushaf. Seluruh hak cipta dilindungi.</p>
    </div>
  </div>
</footer>
