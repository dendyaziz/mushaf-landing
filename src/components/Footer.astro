---
---

<footer class="border-t border-emerald-950/5 bg-[#f5f5f0] py-12 dark:border-emerald-500/10 dark:bg-[#06100c]">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <!-- Col 1: Brand & About -->
      <div class="lg:col-span-2">
        <a href="/" class="flex items-center gap-2.5">
          <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-emerald-600 p-1.5 text-white dark:bg-emerald-500">
            <img src="/images/logo.svg" alt="Mushaf Logo" class="h-full w-full object-contain invert" />
          </div>
          <span class="text-xl font-bold tracking-tight text-slate-900 dark:text-white">
            Mushaf
          </span>
        </a>
        <p class="mt-3.5 max-w-sm text-sm leading-relaxed text-slate-600 dark:text-slate-300">
          Aplikasi Al-Qur'an digital standar Kementerian Agama Republik Indonesia yang dirancang untuk menghadirkan pengalaman tilawah yang tenang, fokus, dan nyaman di setiap saat.
        </p>

        <!-- Contact Email -->
        <div class="mt-4 flex items-center gap-2 text-sm text-slate-700 dark:text-slate-300">
          <svg class="h-4 w-4 text-emerald-600 dark:text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
            <polyline points="22,6 12,13 2,6" />
          </svg>
          <span>Kontak & Bantuan:</span>
          <a
            href="mailto:bantuan@mushaf.web.id"
            class="font-semibold text-emerald-700 underline decoration-emerald-500/40 underline-offset-4 transition-colors hover:text-emerald-600 dark:text-emerald-400"
          >
            bantuan@mushaf.web.id
          </a>
        </div>
      </div>

      <!-- Col 2: Navigation Shortcuts -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-white">
          Navigasi
        </h4>
        <ul class="mt-3.5 space-y-2.5 text-sm">
          <li>
            <a href="/" class="text-slate-600 transition-colors hover:text-emerald-600 dark:text-slate-300 dark:hover:text-emerald-400">
              Beranda
            </a>
          </li>
          <li>
            <a href="#fitur" class="text-slate-600 transition-colors hover:text-emerald-600 dark:text-slate-300 dark:hover:text-emerald-400">
              Fitur Utama
            </a>
          </li>
          <li>
            <a href="#keunggulan" class="text-slate-600 transition-colors hover:text-emerald-600 dark:text-slate-300 dark:hover:text-emerald-400">
              Standar Kemenag
            </a>
          </li>
          <li>
            <a href="#unduh" class="text-slate-600 transition-colors hover:text-emerald-600 dark:text-slate-300 dark:hover:text-emerald-400">
              Unduh Aplikasi
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 3: Legal & Privacy -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-white">
          Kebijakan & Legal
        </h4>
        <ul class="mt-3.5 space-y-2.5 text-sm">
          <li>
            <a href="/kebijakan-privasi" class="text-slate-600 transition-colors hover:text-emerald-600 dark:text-slate-300 dark:hover:text-emerald-400">
              Kebijakan Privasi
            </a>
          </li>
          <li>
            <a href="/syarat-ketentuan" class="text-slate-600 transition-colors hover:text-emerald-600 dark:text-slate-300 dark:hover:text-emerald-400">
              Syarat & Ketentuan
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Copyright -->
    <div class="mt-10 border-t border-slate-200/80 pt-6 text-center text-xs text-slate-500 dark:border-slate-800/80 dark:text-slate-400">
      <p>&copy; {new Date().getFullYear()} Mushaf (mushaf.web.id). Seluruh hak cipta dilindungi undang-undang.</p>
    </div>
  </div>
</footer>
